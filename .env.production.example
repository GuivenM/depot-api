# Modèle de .env pour la PRODUCTION (hébergement mutualisé cPanel).
# Copier en `.env` sur le serveur (jamais dans Git), puis `php artisan key:generate`.
# Voir DEPLOIEMENT.md.

APP_NAME="Depot Boissons"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.mondomaine.com

# Le front (autre domaine) autorisé à appeler l'API depuis le navigateur. Plusieurs : séparés par des virgules.
CORS_ALLOWED_ORIGINS=https://app.mondomaine.com

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Base CENTRALE (liste des dépôts) : fichier SQLite database/database.sqlite (le créer : touch database/database.sqlite).
# Ne mettre AUCUN DB_DATABASE / DB_USERNAME / DB_PASSWORD ici : les bases des dépôts ont leurs propres identifiants.
DB_CONNECTION=sqlite

# Bases des dépôts : créées à la main dans cPanel (> Bases de données MySQL).
TENANT_PROVISIONER=manual
TENANT_DB_HOST=localhost
TENANT_DB_PORT=3306
# Un utilisateur MySQL quelconque du compte : sert seulement à ouvrir la connexion « modèle ».
TENANT_DB_USERNAME=
TENANT_DB_PASSWORD=

# Pas de table cache / sessions / queue dans la base d'un dépôt : tout en fichiers ou synchrone.
CACHE_STORE=file
RATE_LIMITER_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
APP_MAINTENANCE_DRIVER=file
MAIL_MAILER=log

# Tokens : 7 jours. Limites de connexion par minute (dépôt+email+IP, puis IP seule) et de changement de mot de passe.
SANCTUM_EXPIRATION=10080
DEPOT_LOGIN_ATTEMPTS=5
DEPOT_LOGIN_ATTEMPTS_IP=30
DEPOT_PASSWORD_ATTEMPTS=5

# Sauvegardes (voir DEPLOIEMENT.md). BACKUP_PATH doit être HORS du dossier public.
BACKUP_KEEP=14
BACKUP_MONTHS=6
# MYSQLDUMP_PATH=/usr/bin/mysqldump
# MYSQL_CLIENT_PATH=/usr/bin/mysql
# Copie hors du serveur (indispensable) : un disque défini dans config/filesystems.php
# BACKUP_REMOTE_DISK=s3
# BACKUP_REMOTE_PATH=depot-backups
